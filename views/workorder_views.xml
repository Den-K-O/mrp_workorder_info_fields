<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="view_mrp_workorder_tree_inherit" model="ir.ui.view">
        <field name="name">mrp.production.work.order.tree.inherit.qty</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="default_order">id desc</attribute>
            </tree>
            <field name="qty_producing" position="after">
                <field name="qty_produced" optional="hide" width="80px"/>
            </field>
            <field name="workcenter_id" position="after">
                <field name="next_workcenter" optional="show" width="80px"/>
            </field>
            <field name="date_planned_finished" position="after">
                <field name="parent_mo_deadline" optional="show" width="95px"/>
            </field>
            <field name="workcenter_id" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="width">70px</attribute>
            </field>
            <field name="qty_producing" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="optional">hide</attribute>
                <attribute name="width">80px</attribute>
            </field>
            <field name="production_id" position="after">
                <field name="product_id" optional="hide" width="260px"/>
                <field name="source" optional="hide" width="100px"/>
                <field name="priority" widget="priority" optional="show" width="55px"/>
            </field>
            <field name="name" position="attributes">
                <attribute name="width">120px</attribute>
            </field>
            <field name="production_id" position="attributes">
                <attribute name="width">120px</attribute>
            </field>
            <field name="date_planned_start" position="attributes">
                <attribute name="width">130px</attribute>
            </field>
            <field name="date_planned_finished" position="attributes">
                <attribute name="width">60px</attribute>
            </field>
            <field name="date_start" position="attributes">
                <attribute name="width">60px</attribute>
            </field>
            <field name="date_finished" position="attributes">
                <attribute name="width">60px</attribute>
            </field>
            <field name="duration_expected" position="attributes">
                <attribute name="width">75px</attribute>
            </field>
            <field name="duration" position="attributes">
                <attribute name="width">80px</attribute>
            </field>
            <field name="state" position="attributes">
                <attribute name="attrs">{'invisible': [('production_state', '=', 'draft')]}</attribute>
                <attribute name="width">90px</attribute>
            </field>
        </field>
    </record>

    <record id="mrp_workorder_pivot_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.work.order.pivot.inherit.qty</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_pivot" />
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <!-- <field name="qty_producing" type="measure"/> -->
                <field name="qty_produced" type="measure"/>
                <field name="priority"/>
            </xpath>
        </field>
    </record>
</data>